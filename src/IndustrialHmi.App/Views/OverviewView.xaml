<UserControl x:Class="IndustrialHmi.App.Views.OverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:IndustrialHmi.App.Controls" xmlns:m="clr-namespace:IndustrialHmi.Core.Models;assembly=IndustrialHmi.Core">
<StackPanel>
 <DockPanel Margin="0,0,0,20"><TextBlock DockPanel.Dock="Right" Text="01  /  ASSEMBLY CELL" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><StackPanel><TextBlock Text="产线运行概览" Style="{StaticResource Title}"/><TextBlock Text="设备实时状态、运动反馈与安全联锁" Style="{StaticResource MutedText}"/></StackPanel></DockPanel>
 <UniformGrid Columns="3" Margin="0,0,0,20">
  <Border Style="{StaticResource Card}" Margin="0,0,14,0"><StackPanel><TextBlock Text="MACHINE STATUS  /  设备状态" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding StateLabel}" FontSize="34" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,14,0,8"/><TextBlock Text="{Binding OperationMode, StringFormat=当前模式  ·  {0}}" Style="{StaticResource MutedText}"/></StackPanel></Border>
  <Border Style="{StaticResource Card}" Margin="0,0,14,0"><StackPanel><TextBlock Text="PRODUCTION  /  累计完成" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding CycleCount, StringFormat={}{0:N0}}" FontSize="34" FontWeight="Bold" Margin="0,14,0,8"/><TextBlock Text="件  /  计数来自 PLC" Style="{StaticResource MutedText}"/></StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ACTIVE ALARMS  /  当前报警" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding AlarmCount, StringFormat={}{0:00}}" FontSize="34" FontWeight="Bold" Foreground="#FFB66E" Margin="0,14,0,8"/><TextBlock Text="离线时报警数据无效，请查看连接状态" Style="{StaticResource MutedText}" TextWrapping="Wrap"/></StackPanel></Border>
 </UniformGrid>
 <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Style="{StaticResource Card}" Margin="0,0,20,0"><StackPanel><DockPanel><TextBlock Text="运动单元" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="AXIS 01" Foreground="{StaticResource Accent}" HorizontalAlignment="Right"/></DockPanel>
   <Viewbox Height="170" Stretch="Uniform" Margin="0,18,0,12"><Canvas Width="480" Height="150">
    <Rectangle Canvas.Left="28" Canvas.Top="102" Width="420" Height="10" Fill="#33465C" RadiusX="4" RadiusY="4"/>
    <Rectangle Canvas.Left="42" Canvas.Top="54" Width="66" Height="48" Fill="#24394B" Stroke="#66829A" RadiusX="6" RadiusY="6"/><TextBlock Canvas.Left="56" Canvas.Top="70" Text="SERVO" FontSize="10"/>
    <Rectangle Canvas.Left="110" Canvas.Top="73" Width="292" Height="10" Fill="#506A7E"/>
    <Rectangle Canvas.Left="215" Canvas.Top="48" Width="68" Height="54" Fill="#1C4A41" Stroke="#42D6B0" RadiusX="5" RadiusY="5"/><TextBlock Canvas.Left="231" Canvas.Top="66" Text="X01" Foreground="#42D6B0"/>
    <Line X1="215" Y1="34" X2="283" Y2="34" Stroke="#42D6B0" StrokeThickness="2"/><TextBlock Canvas.Left="165" Canvas.Top="125" Text="伺服直线轴 · 位置来自 PLC 反馈" Foreground="#8798AE" FontSize="12"/>
   </Canvas></Viewbox>
   <UniformGrid Columns="2"><StackPanel><TextBlock Text="实际位置 / mm" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Position, StringFormat={}{0:F3}}" FontSize="26" Margin="0,5,0,0"/></StackPanel><StackPanel><TextBlock Text="实际速度 / mm·s⁻¹" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Velocity, StringFormat={}{0:F2}}" FontSize="26" Margin="0,5,0,0"/></StackPanel></UniformGrid>
   <TextBlock Text="示意图不表示实际机械位置；离线数值为最后一次采样。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,14,0,0"/>
  </StackPanel></Border>
  <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="安全与到位信号" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>
   <ItemsControl ItemsSource="{Binding Inputs}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,5"><TextBlock DockPanel.Dock="Right" Text="{Binding Display}" Foreground="{Binding IsOn, Converter={StaticResource SignalBrush}}" FontSize="11"/><Ellipse DockPanel.Dock="Left" Width="7" Height="7" Fill="{Binding IsOn, Converter={StaticResource SignalBrush}}" Margin="0,0,10,0"/><TextBlock Text="{Binding Name}" FontSize="12"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></Border>
 </Grid>
 <Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><DockPanel Margin="0,0,0,16"><TextBlock Text="设备状态机" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="PLC 驱动 / 不在上位机强制切换状态" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></DockPanel>
 <UniformGrid Columns="6"><Border Padding="10,14" Margin="0,0,8,0" CornerRadius="6"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#1C2736"/><Setter Property="BorderBrush" Value="#334155"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value="{x:Static m:MachineState.Idle}"><Setter Property="Background" Value="#1B4037"/><Setter Property="BorderBrush" Value="#42D6B0"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="00 · 待机" FontSize="12" HorizontalAlignment="Center"/></Border><Border Padding="10,14" Margin="0,0,8,0" CornerRadius="6"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#1C2736"/><Setter Property="BorderBrush" Value="#334155"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value="{x:Static m:MachineState.Ready}"><Setter Property="Background" Value="#1B4037"/><Setter Property="BorderBrush" Value="#42D6B0"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="10 · 就绪" FontSize="12" HorizontalAlignment="Center"/></Border><Border Padding="10,14" Margin="0,0,8,0" CornerRadius="6"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#1C2736"/><Setter Property="BorderBrush" Value="#334155"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value="{x:Static m:MachineState.Running}"><Setter Property="Background" Value="#1B4037"/><Setter Property="BorderBrush" Value="#42D6B0"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="20 · 运行" FontSize="12" HorizontalAlignment="Center"/></Border><Border Padding="10,14" Margin="0,0,8,0" CornerRadius="6"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#1C2736"/><Setter Property="BorderBrush" Value="#334155"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value="{x:Static m:MachineState.Paused}"><Setter Property="Background" Value="#1B4037"/><Setter Property="BorderBrush" Value="#42D6B0"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="30 · 暂停" FontSize="12" HorizontalAlignment="Center"/></Border><Border Padding="10,14" Margin="0,0,8,0" CornerRadius="6"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#1C2736"/><Setter Property="BorderBrush" Value="#334155"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value="{x:Static m:MachineState.Fault}"><Setter Property="Background" Value="#1B4037"/><Setter Property="BorderBrush" Value="#42D6B0"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="40 · 故障" FontSize="12" HorizontalAlignment="Center"/></Border><Border Padding="10,14" Margin="0,0,8,0" CornerRadius="6"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#1C2736"/><Setter Property="BorderBrush" Value="#334155"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value="{x:Static m:MachineState.Emergency}"><Setter Property="Background" Value="#1B4037"/><Setter Property="BorderBrush" Value="#42D6B0"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="50 · 急停" FontSize="12" HorizontalAlignment="Center"/></Border></UniformGrid>
 <StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button Content="▶  启动自动" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"/><Button Content="Ⅱ  暂停" Command="{Binding PauseCommand}" IsEnabled="{Binding CanPause}" Margin="0,0,12,0"/><Button Content="↺  故障复位" Command="{Binding ResetCommand}" IsEnabled="{Binding CanReset}"/></StackPanel>
 </StackPanel></Border>
 <Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="位置趋势" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="最近 120 次有效采样 / 纵轴自动缩放" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></DockPanel><c:PositionTrend Samples="{Binding PositionSamples}" Height="110" Margin="0,20,0,8"/><TextBlock Text="历史采样 → 当前     ·     仅显示有效连接期间的实际反馈" Style="{StaticResource MutedText}"/></StackPanel></Border>
</StackPanel>
</UserControl>