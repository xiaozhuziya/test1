<UserControl x:Class="IndustrialHmi.App.Views.AlarmsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:IndustrialHmi.App.Controls" xmlns:m="clr-namespace:IndustrialHmi.Core.Models;assembly=IndustrialHmi.Core">
<StackPanel><DockPanel Margin="0,0,0,24"><TextBlock Text="报警与事件" Style="{StaticResource Title}"/><TextBlock Text="{Binding AlarmCount, StringFormat=当前活动报警  {0}}" Foreground="#FFB66E" HorizontalAlignment="Right"/></DockPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="操作与通讯日志" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/><DataGrid ItemsSource="{Binding Events}" Height="450"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="100"/><DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="100"/><DataGridTextColumn Header="事件内容" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock Text="仅保留本次运行最近 200 条事件；报警恢复自动记录，不提供消除 PLC 故障的本地确认按钮。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,16,0,0"/></StackPanel></Border></StackPanel>
</UserControl>