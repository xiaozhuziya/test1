<Window x:Class="IndustrialHmi.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:IndustrialHmi.App.Views" Title="NEXUS · 汇川工业控制工作站" Width="1440" Height="940" MinWidth="1100" MinHeight="760" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <DataTemplate x:Key="Overview"><v:OverviewView/></DataTemplate><DataTemplate x:Key="Io"><v:IoView/></DataTemplate><DataTemplate x:Key="Manual"><v:ManualView/></DataTemplate><DataTemplate x:Key="Alarms"><v:AlarmsView/></DataTemplate><DataTemplate x:Key="Settings"><v:SettingsView/></DataTemplate>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#101722" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="18,26"><DockPanel>
   <StackPanel DockPanel.Dock="Top" Margin="12,0,0,34"><TextBlock Text="N E X U S" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock Text="INDUSTRIAL WORKSTATION" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,5,0,20"/><TextBlock Text="汇川 · OPC UA 控制站" FontSize="13"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom" Margin="10"><Border Background="#1A2A36" CornerRadius="6" Padding="10"><TextBlock Text="LINE 01  /  装配单元" FontSize="11"/></Border><TextBlock Text="WPF  /  .NET 8  /  MVVM" Style="{StaticResource MutedText}" Margin="0,14,0,0"/><TextBlock Text="设备安全由 PLC 联锁保证" Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel>
   <StackPanel><TextBlock Text="工作空间" Style="{StaticResource MutedText}" Margin="18,0,0,12"/><ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" SelectionChanged="OnPageChanged"/><Border Height="1" Background="{StaticResource Line}" Margin="12,25"/><TextBlock Text="现场总线 / OPC UA" Style="{StaticResource MutedText}" Margin="18,0"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="90"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
   <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="28,16"><DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="8" Height="8" Fill="{Binding IsConnected, Converter={StaticResource SignalBrush}}" Margin="0,0,8,0"/><TextBlock Text="{Binding ModeLabel}" VerticalAlignment="Center" FontSize="11" Margin="0,0,20,0" Foreground="{StaticResource Muted}"/><Button Command="{Binding ToggleConnectionCommand}" MinWidth="110"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Content" Value="连接 PLC"/><Style.Triggers><DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Content" Value="断开连接"/></DataTrigger><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/><Setter Property="Content" Value="连接中…"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="制造执行 / 设备控制" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding SelectedPage}" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
   </DockPanel></Border>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24"><ContentControl Content="{Binding}"><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="ContentTemplate" Value="{StaticResource Overview}"/><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="IO 监控"><Setter Property="ContentTemplate" Value="{StaticResource Io}"/></DataTrigger><DataTrigger Binding="{Binding SelectedPage}" Value="手动调试"><Setter Property="ContentTemplate" Value="{StaticResource Manual}"/></DataTrigger><DataTrigger Binding="{Binding SelectedPage}" Value="报警与事件"><Setter Property="ContentTemplate" Value="{StaticResource Alarms}"/></DataTrigger><DataTrigger Binding="{Binding SelectedPage}" Value="连接设置"><Setter Property="ContentTemplate" Value="{StaticResource Settings}"/></DataTrigger></Style.Triggers></Style></ContentControl.Style></ContentControl></ScrollViewer>
   <Border Grid.Row="2" Background="#101722" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="28,10"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding LastUpdated, StringFormat=最后采样  {0}}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" Style="{StaticResource MutedText}"/></DockPanel></Border>
  </Grid>
 </Grid>
</Window>