<UserControl x:Class="IndustrialHmi.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:IndustrialHmi.App.Controls" xmlns:m="clr-namespace:IndustrialHmi.Core.Models;assembly=IndustrialHmi.Core">
<StackPanel><TextBlock Text="连接与项目配置" Style="{StaticResource Title}"/><TextBlock Text="配置来自应用目录 appsettings.json，修改后重启生效。" Style="{StaticResource MutedText}" Margin="0,0,0,24"/>
 <Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><TextBlock Text="OPC UA / 汇川 PLC" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20"/><TextBlock Text="当前运行方式" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding ModeLabel}" FontSize="18" Margin="0,8,0,20"/><TextBlock Text="端点地址" Style="{StaticResource MutedText}"/><TextBox Text="{Binding Settings.Endpoint, Mode=OneWay}" IsReadOnly="True" Margin="0,8,0,20"/><TextBlock Text="{Binding Settings.PollIntervalMs, StringFormat=采样周期：{0} ms}" Margin="0,0,0,16"/><TextBlock Text="安全策略：Basic256Sha256 · SignAndEncrypt · 严格证书校验" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/></StackPanel></Border>
 <Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><TextBlock Text="接入步骤" Style="{StaticResource Title}"/><TextBlock Text="01   确认 PLC 型号、固件与 OPC UA Server 授权，启用服务并导出符号。" Margin="0,8" TextWrapping="Wrap"/><TextBlock Text="02   用 UaExpert 浏览真实 NodeId，逐项替换 Nodes；示例地址不能直接假定适用。" Margin="0,8" TextWrapping="Wrap"/><TextBlock Text="03   双向信任证书；需要账号时设置 PLC_OPCUA_USER / PLC_OPCUA_PASSWORD。" Margin="0,8" TextWrapping="Wrap"/><TextBlock Text="04   在 PLC 实现命令边沿、限位、心跳超时、模式与安全联锁。" Margin="0,8" TextWrapping="Wrap"/><TextBlock Text="05   设置 Simulation=false，重启后手动连接；按 docs/commissioning.md 验收。" Margin="0,8" TextWrapping="Wrap"/></StackPanel></Border>
 <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="工程边界" Style="{StaticResource Title}"/><TextBlock Text="本项目是教学与二次开发案例，不含现场已认证的安全功能。没有真实 PLC 时可完整体验模拟业务；真实运动必须由 PLC 和硬件安全回路约束。" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Border>
</StackPanel>
</UserControl>