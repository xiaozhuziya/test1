<UserControl x:Class="IndustrialHmi.App.Views.IoView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:IndustrialHmi.App.Controls" xmlns:m="clr-namespace:IndustrialHmi.Core.Models;assembly=IndustrialHmi.Core">
<StackPanel><TextBlock Text="数字量输入" Style="{StaticResource Title}"/><TextBlock Text="地址为示例逻辑编号，实际 OPC UA 节点请在配置文件中映射。输入只读。" Style="{StaticResource MutedText}" Margin="0,0,0,24"/>
 <ItemsControl ItemsSource="{Binding Inputs}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,14,14"><StackPanel><DockPanel><TextBlock Text="{Binding Address}" Style="{StaticResource MutedText}"/><Ellipse Width="10" Height="10" HorizontalAlignment="Right" Fill="{Binding IsOn, Converter={StaticResource SignalBrush}}"/></DockPanel><TextBlock Text="{Binding Name}" FontSize="18" Margin="0,18,0,10"/><TextBlock Text="{Binding Display}" FontSize="22" Foreground="{Binding IsOn, Converter={StaticResource SignalBrush}}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <TextBlock Text="数字量输出反馈（只读）" Style="{StaticResource Title}" Margin="0,20,0,16"/>
 <ItemsControl ItemsSource="{Binding Outputs}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,14,14"><StackPanel><DockPanel><TextBlock Text="{Binding Address}" Style="{StaticResource MutedText}"/><Ellipse Width="10" Height="10" HorizontalAlignment="Right" Fill="{Binding IsOn, Converter={StaticResource SignalBrush}}"/></DockPanel><TextBlock Text="{Binding Name}" FontSize="18" Margin="0,18,0,10"/><TextBlock Text="{Binding Display}" FontSize="22" Foreground="{Binding IsOn, Converter={StaticResource SignalBrush}}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel><TextBlock Text="数据质量" Style="{StaticResource Title}"/><TextBlock Text="整批节点质量为 Good 且类型正确后才更新画面。连接断开或读取失败时，输入显示“未知”，控制指令禁用。" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><TextBlock Text="手动输出请在“手动调试”页操作；不提供绕过联锁的直接 DO 强制功能。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
</StackPanel>
</UserControl>